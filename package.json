{
  "name": "fit-arena",
  "version": "1.0.0",
  "description": "Telegram Mini App: соревнования в отжиманиях, приседаниях и прессе с подсчётом повторов камерой",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:server": "ALLOW_GUESTS=1 tsx watch server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=cjs --external:bufferutil --external:utf-8-validate --outfile=dist-server/server.cjs && cp public/bot/welcome.jpg dist-server/welcome.jpg && mkdir -p dist-server/media && cp -r server/media/channel dist-server/media/ && cp -r public/emoji dist-server/media/"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
